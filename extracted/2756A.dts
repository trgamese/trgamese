					isg5320a_sub,hallic_cert_detect = <0x00>;
				};
			};

			sec_thermistor@0 {
				compatible = "samsung,sec-thermistor";
				status = "okay";
				thermistor_name = "sec-ap-thermistor";
				id = <0x00>;
				adc_channel = <0x00>;
