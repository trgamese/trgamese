	fragment@model {
		target-path = [2f 00];

		__overlay__ {

			firmware {

				android {
					compatible = "android,firmware";

					vbmeta {
						compatible = "android,vbmeta";
						parts = "vbmeta,vbmeta_samsung,boot,system,vendor,product,odm,prism,optics,recovery,tee1,lk";
					};

					fstab {
						compatible = "android,fstab";
						status = "disabled";
					};
				};
			};

			usb_notifier {
				compatible = "samsung,usb-notifier";
			};

			muic {
				new_factory;
				dcd_timeout;
			};

			aliases {
				i2c23 = "/i2c@23";
				i2c24 = "/i2c@24";
			};

			i2c@23 {
				cell-index = <0x17>;
				status = "okay";
				compatible = "i2c-gpio";
				gpios = <0xffffffff 0x1e 0x00 0xffffffff 0x1c 0x00>;
				i2c-gpio,delay-us = <0x02>;
				#address-cells = <0x01>;
				#size-cells = <0x00>;
				pinctrl-names = "default";
				pinctrl-0 = <0x25 0x26>;
				phandle = <0x65>;

				lis2ds@1D {
