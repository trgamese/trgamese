/dts-v1/;

/ {
	compatible = "Samsung,A02 EUR OPEN 01\0Mediatek,MT6739";
	dtbo-hw_rev = <0x06>;
	dtbo-hw_rev_end = <0x20>;

	fragment@smd {
		target-path = [2f 00];

		__overlay__ {

			samsung_mobile_device {
				compatible = "simple-bus";
				phandle = <0x52>;

				s2mu005-charger {
					status = "disable";
					compatible = "samsung,s2mu005-charger";
					battery,is_1MHz_switching = <0x01>;
					battery,chg_gpio_en = <0x00>;
					battery,chg_polarity_en = <0x00>;
					battery,chg_gpio_status = <0x00>;
					battery,chg_polarity_status = <0x00>;
					phandle = <0x53>;
				};

				sec_abc {
					compatible = "samsung,sec_abc";
					status = "okay";

					gpu {
						gpu,label = "GPU fault";
						gpu,threshold_count = <0x14>;
						gpu,threshold_time = <0x4b0>;
					};

					aicl {
						aicl,label = "battery aicl";
						aicl,threshold_count = <0x05>;
						aicl,threshold_time = <0x12c>;
					};
				};

				abc_hub {
					compatible = "samsung,abc_hub";
					status = "okay";

					bootc {
						bootc,time_spec_user = <0x186a0>;
						bootc,time_spec_eng = <0x249f0>;
						bootc,time_spec_fac = <0x186a0>;
					};
				};

				input_booster {
					status = "okay";
					compatible = "input_booster";
					resValcount = [32 00];
					max_resource_count = [32 00];
					max_cluster_count = [33 00];
					#address-cells = <0x01>;
					#size-cells = <0x00>;
					cpu_cluster_policy = [30 00];
					ib_release_values = "-1,-1";
					allowed_resources = "0,1";

					booster_key@1 {
						input_booster,label = "key";
						input_booster,type = <0x00>;
						input_booster,head_time = <0xc8>;
						input_booster,tail_time = <0x00>;

						inputbooster,resource {
							compatible = "resource";

							resource@1 {
								resource,label = "CPU";
								resource,value = <0x137090 0x00>;
							};

							resource@2 {
								resource,label = "DDR";
								resource,value = <0x3e7 0x3e7>;
							};
						};
					};

					booster_key@2 {
						input_booster,label = "touchkey";
						input_booster,type = <0x01>;
						input_booster,head_time = <0x01>;
						input_booster,tail_time = <0x12c>;

						inputbooster,resource {
							compatible = "resource";

							resource@1 {
								resource,label = "CPU";
								resource,value = <0x00 0x101148>;
							};

							resource@2 {
								resource,label = "DDR";
								resource,value = <0x3e7 0x3e7>;
							};
						};
					};

					booster_key@3 {
						input_booster,label = "touch";
						input_booster,type = <0x02>;
						input_booster,head_time = <0x82>;
						input_booster,tail_time = <0x1f4>;

						inputbooster,resource {
							compatible = "resource";

							resource@1 {
								resource,label = "CPU";
								resource,value = <0x1506d0 0x137090>;
							};

							resource@2 {
								resource,label = "DDR";
								resource,value = <0x3e7 0x3e7>;
							};
						};
					};

					booster_key@4 {
						input_booster,label = "multitouch";
						input_booster,type = <0x03>;
						input_booster,head_time = <0x3e8>;
						input_booster,tail_time = <0x1f4>;

						inputbooster,resource {
							compatible = "resource";

							resource@1 {
								resource,label = "CPU";
								resource,value = <0x1506d0 0x137090>;
							};

							resource@2 {
								resource,label = "DDR";
								resource,value = <0x3e7 0x3e7>;
							};
						};
					};

					booster_key@5 {
						input_booster,label = "keyboard";
						input_booster,type = <0x04>;
						input_booster,head_time = <0x82>;
						input_booster,tail_time = <0x82>;

						inputbooster,resource {
							compatible = "resource";

							resource@1 {
								resource,label = "CPU";
								resource,value = <0x101148 0x101148>;
							};

							resource@2 {
								resource,label = "DDR";
								resource,value = <0x3e7 0x3e7>;
							};
						};
					};

					booster_key@6 {
						input_booster,label = "MOUSE";
						input_booster,type = <0x05>;
						input_booster,head_time = <0xc8>;
						input_booster,tail_time = <0x12c>;

						inputbooster,resource {
							compatible = "resource";

							resource@1 {
								resource,label = "CPU";
								resource,value = <0x137090 0x101148>;
							};

							resource@2 {
								resource,label = "DDR";
								resource,value = <0x3e7 0x3e7>;
							};
						};
					};

					booster_key@7 {
						input_booster,label = "mouse_wheel";
						input_booster,type = <0x06>;
						input_booster,head_time = <0xc8>;
						input_booster,tail_time = <0x00>;

						inputbooster,resource {
							compatible = "resource";

							resource@1 {
								resource,label = "CPU";
								resource,value = <0x137090 0x00>;
							};

							resource@2 {
								resource,label = "DDR";
								resource,value = <0x3e7 0x3e7>;
							};
						};
					};

					booster_key@8 {
						input_booster,label = "pen_hover";
						input_booster,type = <0x07>;
						input_booster,head_time = <0xc8>;
						input_booster,tail_time = <0x12c>;

						inputbooster,resource {
							compatible = "resource";

							resource@1 {
								resource,label = "CPU";
								resource,value = <0x137090 0x101148>;
							};

							resource@2 {
								resource,label = "DDR";
								resource,value = <0x3e7 0x3e7>;
							};
						};
					};

					booster_key@9 {
						input_booster,label = "pen";
						input_booster,type = <0x08>;
						input_booster,head_time = <0xc8>;
						input_booster,tail_time = <0x258>;

						inputbooster,resource {
							compatible = "resource";

							resource@1 {
								resource,label = "CPU";
								resource,value = <0x137090 0x101148>;
							};

							resource@2 {
								resource,label = "DDR";
								resource,value = <0x3e7 0x3e7>;
							};
						};
					};
				};

				sec_thermistor@0 {
