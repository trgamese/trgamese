					st,irq_gpio = <0xffffffff 0x08 0x00>;
					st,orientation = <0x02 0x01 0x01 0x01 0x00 0x01 0x01 0x01 0x02>;
					st,vdd_ldo_pin = <0xffffffff 0x60 0x00>;
